{
  "name": "markupress",
  "version": "0.14.0",
  "description": "Versioned Markdown documentation built on MarkupKit and native declarative components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controllers/shell.js": "./dist/controllers/shell.js",
    "./controllers/code.js": "./dist/controllers/code.js",
    "./controllers/outline.js": "./dist/controllers/outline.js",
    "./controllers/search.js": "./dist/controllers/search.js",
    "./styles/base.css": "./styles/base.css",
    "./styles/prose.css": "./styles/prose.css"
  },
  "files": [
    "dist",
    "styles",
    "theme"
  ],
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15 <25"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "test": "pnpm build && vitest run --exclude tests/package.test.ts",
    "test:package": "vitest run tests/package.test.ts",
    "verify:inner": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:pr": "pnpm verify:inner && pnpm build && pnpm test:package && pnpm build:sites",
    "build:sites": "node dist/cli.js build --root website && node dist/cli.js build --root examples/site",
    "verify:extended": "pnpm verify:pr",
    "verify:release": "pnpm verify:pr && pnpm pack --dry-run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "playwright": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "@nextwebwg/html-next": ">=1.0.0-alpha.74",
    "@threadlabs/looma": ">=0.44.0 <0.45 || >=0.46.1",
    "jsdom": "30.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/markupress.git"
  },
  "homepage": "https://github.com/threadlabs-studio/markupress#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/markupress/issues"
  },
  "dependencies": {
    "expressmark": ">=0.4.0",
    "@threadlabs/markupkit": ">=0.4.2",
    "parse5": "8.0.1",
    "yaml": "2.9.1",
    "postcss": "8.5.32",
    "postcss-value-parser": "4.2.0",
    "shiki": "4.5.0",
    "vite": "8.3.5",
    "minisearch": "7.2.0"
  },
  "peerDependencies": {
    "@nextwebwg/html-next": ">=1.0.0-alpha.69",
    "@threadlabs/looma": ">=0.44.0 <0.45 || >=0.46.1"
  },
  "bin": {
    "markupress": "./dist/cli.js"
  }
}
